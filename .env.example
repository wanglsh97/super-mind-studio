# Runtime
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Private in-network Collector endpoint. Defaults to http://otel-collector:4318/v1/traces.
OTEL_SERVICE_NAME=supermind-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# Required only when using the production same-origin /otel ingestion route.
OTEL_INGEST_TOKEN=
# Development only: use these after starting compose.observability.dev.yml.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# TEMPO_QUERY_URL=http://127.0.0.1:3200

# LangSmith 真实 Agent Eval（可选，仅 apps/api test:eval 离线脚本；不进入运行时服务）。
# 无 KEY 或 LANGSMITH_EVAL_LIVE≠true 时脚本 exit 0 跳过。Live 会产生真实模型/工具费用。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=super-mind-studio-eval
LANGSMITH_TRACING=false
LANGSMITH_EVAL_LIVE=false
LANGSMITH_EVAL_MODEL=kimi
LANGSMITH_EVAL_JUDGE_MODEL=kimi
# LANGSMITH_EVAL_GENERAL_DATASET=super-mind-studio-web-agent-eval-v1
# LANGSMITH_EVAL_WEBSITE_DATASET=super-mind-studio-website-agent-eval-v1
# LANGSMITH_EVAL_GENERAL_TIMEOUT_MS=180000
# LANGSMITH_EVAL_WEBSITE_TIMEOUT_MS=600000

# PostgreSQL / Redis
POSTGRES_DB=aigateway
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://aigateway:change-me-in-production@localhost:5432/aigateway?schema=public
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
TRUSTED_PROXY_HOPS=1

# User authentication. Anonymous login is always available in every environment.
# Create separate OAuth clients for local development when enabling GitHub or Google.
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
GITHUB_OAUTH_HTTP_TIMEOUT_MS=10000
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_OAUTH_HTTP_TIMEOUT_MS=10000
USER_SESSION_SECRET=development-only-user-session-secret-change-me
USER_SESSION_TTL_SECONDS=2592000

# Executable Skill and user-file object storage. Keep `memory` for local Mock flows.
SKILL_OBJECT_STORE_DRIVER=memory
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_INTERNAL=false
OSS_TIMEOUT_MS=30000
SKILL_UPLOAD_TTL_SECONDS=300
SKILL_STAGING_CLEANUP_BATCH=100

# Executable Skill sandbox. Local and production API processes both require OpenSandbox.
SANDBOX_TIMEOUT_SECONDS=3600
OPEN_SANDBOX_DOMAIN=10.0.0.10:8080
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_API_KEY=replace-with-a-strong-opensandbox-api-key
OPEN_SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.1.0
OPEN_SANDBOX_REQUEST_TIMEOUT_SECONDS=30
OPEN_SANDBOX_READY_TIMEOUT_SECONDS=60
# Keep true when NestJS cannot directly reach per-sandbox execd ports.
OPEN_SANDBOX_USE_SERVER_PROXY=true

# Provider switches: Mock is the only provider enabled during initial setup
MOCK_PROVIDER_ENABLED=true
# Agent web_fetch: omit or false = production live fetch; true = deterministic fixture (CI/E2E)
AGENT_WEB_FETCH_FIXTURE=false
# Different Threads may run concurrently; one Thread still allows only one active Run.
AGENT_MAX_CONCURRENT_RUNS_PER_USER=3
# Agent web_search: anonymous Exa/Parallel MCP works without keys; use `auto` for stable
# per-run routing. Anonymous quotas are intended for development/smoke, not a production SLA.
AGENT_WEB_SEARCH_ENABLED=true
AGENT_WEB_SEARCH_PROVIDER=auto
AGENT_WEB_SEARCH_TIMEOUT_MS=25000
AGENT_WEB_SEARCH_MAX_RESPONSE_BYTES=2097152
AGENT_WEB_SEARCH_MAX_OUTPUT_CHARS=30000
# Optional future server-only credentials. Keep empty for the anonymous free flow.
EXA_API_KEY=
PARALLEL_API_KEY=
# Platform MCP endpoints are release-controlled in
# apps/api/src/agent/mcp/agent-mcp.config.ts. Define only provider credentials
# in the deployment environment, and never commit them.
QCC_API_KEY=
ROLLINGGO_MCP_API_KEY=
AMAP_MCP_API_KEY=
VARIFLIGHT_MCP_API_KEY=
AGENT_MCP_DISCOVERY_TIMEOUT_MS=10000
AGENT_MCP_CALL_TIMEOUT_MS=30000
AGENT_MCP_MAX_TOOLS_PER_SERVER=50
AGENT_MCP_MAX_RESPONSE_BYTES=1048576
AGENT_MCP_MAX_OUTPUT_CHARS=20000
QWEN_ENABLED=false
GLM_ENABLED=false
DEEPSEEK_ENABLED=false
KIMI_ENABLED=false

# Real provider credentials; keep empty while the provider is disabled
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Chat 模型目录统一维护在 apps/api/src/chat/chat-models.config.ts，不能通过环境变量覆盖。
QWEN_FALLBACK_ALIAS=
GLM_FALLBACK_ALIAS=
DEEPSEEK_FALLBACK_ALIAS=
KIMI_FALLBACK_ALIAS=
PROMPT_OPTIMIZER_MODEL=qwen

# Initial rate-limit defaults
CHAT_RATE_LIMIT_PER_MINUTE=10
IMAGE_RATE_LIMIT_PER_MINUTE=5
IMAGE_DOWNLOAD_MAX_BYTES=10000000
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ADMIN_FIXED_CREDENTIALS_ENABLED=true
ADMIN_SESSION_SECRET=development-only-admin-session-secret-change-me
ADMIN_SESSION_TTL_SECONDS=900
CHAT_MAX_TOKENS=4096
PROVIDER_HEALTH_TTL_SECONDS=300
PROVIDER_HEALTH_FAILURE_THRESHOLD=3
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_CONNECTIONS=20
PRICING_VERSION=dev-v1
QWEN_INPUT_PRICE_CNY_PER_MILLION=
QWEN_OUTPUT_PRICE_CNY_PER_MILLION=
GLM_INPUT_PRICE_CNY_PER_MILLION=
GLM_OUTPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_INPUT_PRICE_CNY_PER_MILLION=
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=
KIMI_INPUT_PRICE_CNY_PER_MILLION=
KIMI_OUTPUT_PRICE_CNY_PER_MILLION=
