# Release identity and public entry
APP_VERSION=replace-with-git-sha
DOMAIN=example.com
PUBLIC_IP=203.0.113.10
HTTP_PORT=80
SMOKE_MODEL_ALIAS=qwen

# API runtime
NODE_ENV=production
API_PORT=3001
WEB_ORIGIN=https://example.com
LOG_LEVEL=info
TRUSTED_PROXY_HOPS=1

# User authentication. Anonymous login is always available. OAuth providers are independent.
GITHUB_OAUTH_ENABLED=true
GITHUB_CLIENT_ID=replace-with-production-github-client-id
GITHUB_CLIENT_SECRET=replace-with-production-github-client-secret
GITHUB_CALLBACK_URL=https://example.com/api/v1/auth/github/callback
GITHUB_OAUTH_HTTP_TIMEOUT_MS=10000
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-production-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-production-google-client-secret
GOOGLE_CALLBACK_URL=https://example.com/api/v1/auth/google/callback
GOOGLE_OAUTH_HTTP_TIMEOUT_MS=10000
USER_SESSION_SECRET=replace-with-at-least-32-random-characters
USER_SESSION_TTL_SECONDS=2592000

# PostgreSQL / Redis (DATABASE_URL password must be URL-encoded)
POSTGRES_DB=aigateway
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://aigateway:replace-with-url-encoded-password@postgres:5432/aigateway?schema=public
DATABASE_POOL_MAX=10
REDIS_URL=redis://redis:6379

# Provider switches. Start the first ECS deployment in Mock-only mode.
MOCK_PROVIDER_ENABLED=true
QWEN_ENABLED=false
GLM_ENABLED=false
DEEPSEEK_ENABLED=false
KIMI_ENABLED=false
WANXIANG_ENABLED=false
COGVIEW_ENABLED=false

# Provider credentials are injected only on ECS. Never commit real values.
# Chat 模型目录统一维护在 apps/api/src/chat/chat-models.config.ts，不能通过环境变量覆盖。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

WANXIANG_API_KEY=
WANXIANG_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WANXIANG_MODEL_ID=
COGVIEW_API_KEY=
COGVIEW_BASE_URL=https://open.bigmodel.cn/api/paas/v4
COGVIEW_MODEL_ID=

# Platform-managed Agent MCP. Keep disabled until each remote server is reviewed.
# Different Threads may run concurrently; set to 1 for immediate serial-mode rollback.
AGENT_MAX_CONCURRENT_RUNS_PER_USER=3
# The example Compose explicitly passes AGENT_MCP_TOKEN to the API container.
# Add further token env names to the API environment allowlist before referencing them.
AGENT_MCP_SERVERS_JSON=[]
AGENT_MCP_TOKEN=
AGENT_MCP_DISCOVERY_TIMEOUT_MS=10000
AGENT_MCP_CALL_TIMEOUT_MS=30000
AGENT_MCP_MAX_TOOLS_PER_SERVER=50
AGENT_MCP_MAX_RESPONSE_BYTES=1048576
AGENT_MCP_MAX_OUTPUT_CHARS=20000

# Feature defaults
PROMPT_OPTIMIZER_MODEL=qwen
CHAT_RATE_LIMIT_PER_MINUTE=10
IMAGE_RATE_LIMIT_PER_MINUTE=5
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
ADMIN_FIXED_CREDENTIALS_ENABLED=false
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_SECONDS=900
CHAT_MAX_TOKENS=4096
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_CONNECTIONS=20
