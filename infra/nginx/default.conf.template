upstream aigateway_web {
    server web:3000;
    keepalive 16;
}

upstream aigateway_api {
    server api:3001;
    keepalive 32;
}

upstream aigateway_otel_collector {
    server otel-collector:4318;
    keepalive 8;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${PUBLIC_IP} _;

    set $supermind_maintenance_mode "${MAINTENANCE_MODE}";
    include /etc/nginx/includes/app-locations.conf;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://${DOMAIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;

    set $supermind_maintenance_mode "${MAINTENANCE_MODE}";

    location /otel/ {
        if ($http_x_otel_ingest_token != "${OTEL_INGEST_TOKEN}") { return 404; }
        proxy_pass http://aigateway_otel_collector/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 15s;
        access_log off;
    }

    include /etc/nginx/includes/app-locations.conf;
}
