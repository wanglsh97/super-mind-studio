generator client {
  provider               = "prisma-client"
  output                 = "../apps/api/src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum RequestCapability {
  CHAT
  IMAGE
  PROMPT
  AGENT
  VIDEO
}

enum RequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ImageTaskStatus {
  PENDING
  SUBMITTING
  RUNNING
  PERSISTING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
  EXPIRED
  SUBMISSION_UNKNOWN
}

enum AdminAuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AgentRunStatus {
  RUNNING
  CANCELLING
  WAITING_FOR_USER
  SUCCEEDED
  FAILED
  CANCELLED
  LIMIT_REACHED
  INTERRUPTED
}

enum AgentRunLimitReason {
  MODEL_CALLS
  TOOL_CALLS
  WEB_FETCH_CALLS
  DURATION
  CONTEXT_WINDOW
  SANDBOX_DURATION
  SHELL_CALLS
  SANDBOX_OUTPUT
  SANDBOX_EGRESS
  SANDBOX_RESOURCE
}

enum AgentMessageRole {
  USER
  ASSISTANT
  TOOL
}

enum AgentToolCallStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentUserQuestionStatus {
  PENDING
  ANSWERED
  SKIPPED
  CANCELLED
  INTERRUPTED
}

enum AgentInvocationStatus {
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentInvocationAttributionKind {
  SKILL
  TOOL
}

enum SkillStatus {
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  DELISTED
}

enum SkillReviewDecision {
  APPROVED
  REJECTED
}

enum UserFileDirection {
  INPUT
  OUTPUT
}

enum UserFileStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETING
  CLEANUP_PENDING
  DELETED
}

enum SkillUploadSessionStatus {
  PENDING_UPLOAD
  FINALIZED
  ABANDONED
}

enum ObjectCleanupStatus {
  NONE
  PENDING
  SUCCEEDED
}

enum AuthProvider {
  ANONYMOUS
  GITHUB
  GOOGLE
}

enum CreationType {
  WEBSITE
  IMAGE
  VIDEO
}

enum CreationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
  DELETING
}

enum WebProjectStatus {
  PENDING
  GENERATING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum CreationAssetKind {
  SOURCE_ZIP
  DIST_ZIP
  PREVIEW
  IMAGE
  VIDEO
}

enum VideoTaskStatus {
  PENDING
  SUBMITTING
  RUNNING
  PERSISTING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
  EXPIRED
}

model User {
  id               String                    @id @default(uuid()) @db.Uuid
  authProvider     AuthProvider
  providerUserId   String                    @db.VarChar(255)
  userName         String                    @db.VarChar(255)
  avatarUrl        String?                   @db.VarChar(2048)
  email            String?                   @db.VarChar(320)
  lastLoginAt      DateTime                  @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)
  sessions         UserSession[]
  requestLogs      RequestLog[]
  imageTasks       ImageGenerationTask[]
  videoTasks       VideoGenerationTask[]
  videoInputAssets VideoInputAsset[]
  agentThreads     AgentThread[]
  agentRuns        AgentRun[]
  agentSkills      UserAgentSkill[]
  mcpPreferences   UserMcpServerPreference[]
  ownedSkills      Skill[]                   @relation("SkillOwner")
  files            UserFile[]
  skillUploads     SkillUploadSession[]
  modelInvocations AgentModelInvocation[]
  creations        Creation[]
  webProjects      WebProject[]

  @@unique([authProvider, providerUserId])
  @@index([userName])
  @@index([createdAt])
}

model UserMcpServerPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  serverId  String   @db.VarChar(64)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, enabled])
}

model SkillUploadSession {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @db.Uuid
  skillId             String?                  @db.Uuid
  objectKey           String                   @db.VarChar(1024)
  status              SkillUploadSessionStatus @default(PENDING_UPLOAD)
  cleanupStatus       ObjectCleanupStatus      @default(NONE)
  expectedContentType String                   @db.VarChar(255)
  expectedSizeBytes   BigInt
  expectedSha256      String                   @db.Char(64)
  observedSizeBytes   BigInt?
  observedSha256      String?                  @db.Char(64)
  expiresAt           DateTime                 @db.Timestamptz(3)
  finalizedAt         DateTime?                @db.Timestamptz(3)
  abandonedAt         DateTime?                @db.Timestamptz(3)
  cleanupAttempts     Int                      @default(0)
  cleanupError        String?                  @db.Text
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill               Skill?                   @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([skillId, createdAt])
  @@index([objectKey])
  @@index([status, expiresAt])
  @@index([cleanupStatus, updatedAt])
}

model UserAgentSkill {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  skillId       String   @db.VarChar(64)
  marketSkillId String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketSkill   Skill?   @relation(fields: [marketSkillId], references: [id], onDelete: Restrict)

  @@unique([userId, skillId])
  @@unique([userId, marketSkillId])
  @@index([userId, createdAt])
  @@index([skillId])
  @@index([marketSkillId])
}

model Skill {
  id                   String               @id @default(uuid()) @db.Uuid
  name                 String               @unique @db.VarChar(64)
  ownerId              String               @db.Uuid
  title                String               @db.VarChar(120)
  description          String               @db.VarChar(400)
  category             String               @db.VarChar(40)
  status               SkillStatus          @default(PENDING_REVIEW)
  iconObjectKey        String?              @db.VarChar(1024)
  packageObjectKey     String?              @unique @db.VarChar(1024)
  packageSha256        String?              @db.Char(64)
  packageSizeBytes     BigInt?
  skillMarkdown        String?              @db.Text
  fileTree             Json?
  addCount             Int                  @default(0)
  publishedAt          DateTime?            @db.Timestamptz(3)
  delistedAt           DateTime?            @db.Timestamptz(3)
  packageUpdatedAt     DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  owner                User                 @relation("SkillOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  reviews              SkillReview[]
  userAdds             UserAgentSkill[]
  agentToolCallRecords AgentToolCall[]
  uploadSessions       SkillUploadSession[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@index([ownerId, updatedAt])
  @@index([addCount])
}

model SkillReview {
  id            String              @id @default(uuid()) @db.Uuid
  skillId       String              @db.Uuid
  reviewer      String              @db.VarChar(64)
  decision      SkillReviewDecision
  reason        String?             @db.Text
  packageSha256 String              @db.Char(64)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  skill         Skill               @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@index([skillId, createdAt])
  @@index([reviewer, createdAt])
}

model UserFile {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  runId            String?           @db.Uuid
  sourceToolCallId String?           @db.Uuid
  sandboxPath      String?           @db.VarChar(1024)
  direction        UserFileDirection
  status           UserFileStatus    @default(PENDING_UPLOAD)
  name             String            @db.VarChar(255)
  mimeType         String?           @db.VarChar(255)
  objectKey        String            @unique @db.VarChar(1024)
  sizeBytes        BigInt
  sha256           String?           @db.Char(64)
  deletedAt        DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  run              AgentRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  sourceToolCall   AgentToolCall?    @relation(fields: [sourceToolCallId], references: [id], onDelete: SetNull)

  @@unique([runId, direction, sandboxPath])
  @@index([userId, status, createdAt])
  @@index([runId])
  @@index([sourceToolCallId])
}

model UserSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique @db.Char(64)
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RequestLog {
  id                   String                @id @default(uuid()) @db.Uuid
  requestId            String                @unique @default(uuid()) @db.Uuid
  capability           RequestCapability
  prompt               Json
  modelAlias           String                @db.VarChar(64)
  provider             String?               @db.VarChar(64)
  resolvedModel        String?               @db.VarChar(128)
  providerRequestId    String?               @db.VarChar(191)
  status               RequestStatus         @default(PENDING)
  stream               Boolean               @default(false)
  clientIp             String?               @db.VarChar(64)
  startedAt            DateTime              @default(now()) @db.Timestamptz(3)
  firstTokenAt         DateTime?             @db.Timestamptz(3)
  completedAt          DateTime?             @db.Timestamptz(3)
  durationMs           Int?
  failoverFrom         String?               @db.VarChar(64)
  failoverTo           String?               @db.VarChar(64)
  failoverReason       String?               @db.VarChar(255)
  errorCode            String?               @db.VarChar(64)
  errorMessage         String?               @db.Text
  errorDetails         Json?
  metadata             Json?
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  userId               String                @db.Uuid
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  agentRunId           String?               @db.Uuid
  agentRun             AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  billing              BillingRecord?
  agentModelInvocation AgentModelInvocation?
  imageTask            ImageGenerationTask?
  videoGenerationTask  VideoGenerationTask?

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([modelAlias, createdAt])
  @@index([capability, createdAt])
  @@index([agentRunId])
}

model BillingRecord {
  id               String     @id @default(uuid()) @db.Uuid
  requestLogId     String     @unique @db.Uuid
  inputTokens      Int?
  outputTokens     Int?
  totalTokens      Int?
  usageUnknown     Boolean    @default(true)
  priceVersion     String?    @db.VarChar(64)
  inputCostCny     Decimal?   @db.Decimal(18, 8)
  outputCostCny    Decimal?   @db.Decimal(18, 8)
  estimatedCostCny Decimal?   @db.Decimal(18, 8)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  requestLog       RequestLog @relation(fields: [requestLogId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model ImageGenerationTask {
  id                String                @id @default(uuid()) @db.Uuid
  taskId            String                @unique @default(uuid()) @db.Uuid
  requestLogId      String                @unique @db.Uuid
  providerTaskId    String?               @db.VarChar(191)
  prompt            String                @db.Text
  effectivePrompt   String?               @db.Text
  modelAlias        String                @db.VarChar(64)
  provider          String?               @db.VarChar(64)
  resolvedModel     String?               @db.VarChar(128)
  options           Json?
  status            ImageTaskStatus       @default(PENDING)
  results           Json?
  errorCode         String?               @db.VarChar(64)
  errorMessage      String?               @db.Text
  lastPolledAt      DateTime?             @db.Timestamptz(3)
  nextPollAt        DateTime?             @db.Timestamptz(3)
  pollAttempts      Int                   @default(0)
  persistAttempts   Int                   @default(0)
  leaseOwner        String?               @db.VarChar(191)
  leaseExpiresAt    DateTime?             @db.Timestamptz(3)
  agentRunId        String?               @db.Uuid
  agentToolCallId   String?               @unique @db.Uuid
  parentImageTaskId String?               @db.Uuid
  imageId           String?               @unique @db.Uuid
  sandboxId         String?               @db.VarChar(191)
  sandboxPath       String?               @db.Text
  sandboxExpiresAt  DateTime?             @db.Timestamptz(3)
  mimeType          String?               @db.VarChar(255)
  sizeBytes         BigInt?
  sha256            String?               @db.Char(64)
  providerResultUrl String?               @db.Text
  cancelRequestedAt DateTime?             @db.Timestamptz(3)
  expiredAt         DateTime?             @db.Timestamptz(3)
  startedAt         DateTime?             @db.Timestamptz(3)
  completedAt       DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)
  userId            String                @db.Uuid
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestLog        RequestLog            @relation(fields: [requestLogId], references: [id], onDelete: Cascade)
  agentRun          AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentToolCall     AgentToolCall?        @relation(fields: [agentToolCallId], references: [id], onDelete: SetNull)
  parentImageTask   ImageGenerationTask?  @relation("ImageTaskChain", fields: [parentImageTaskId], references: [id], onDelete: SetNull)
  childImageTasks   ImageGenerationTask[] @relation("ImageTaskChain")
  creation          Creation?

  @@unique([provider, providerTaskId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextPollAt, leaseExpiresAt])
  @@index([agentRunId])
  @@index([parentImageTaskId])
  @@index([createdAt])
}

model VideoGenerationTask {
  id                  String                @id @default(uuid()) @db.Uuid
  taskId              String                @unique @default(uuid()) @db.Uuid
  requestLogId        String                @unique @db.Uuid
  userId              String                @db.Uuid
  threadId            String                @db.Uuid
  agentRunId          String?               @db.Uuid
  agentToolCallId     String?               @unique @db.Uuid
  parentVideoTaskId   String?               @db.Uuid
  videoId             String?               @unique @db.Uuid
  idempotencyKey      String                @unique @db.VarChar(191)
  prompt              String                @db.Text
  effectivePrompt     String                @db.Text
  inputMode           String                @db.VarChar(32)
  referenceImageId    String?               @db.Uuid
  options             Json?
  candidateAudit      Json?
  provider            String?               @db.VarChar(64)
  resolvedModel       String?               @db.VarChar(128)
  providerTaskId      String?               @db.VarChar(191)
  status              VideoTaskStatus       @default(PENDING)
  providerFinalStatus String?               @db.VarChar(32)
  providerResultUrl   String?               @db.Text
  nextPollAt          DateTime?             @db.Timestamptz(3)
  lastPolledAt        DateTime?             @db.Timestamptz(3)
  pollAttempts        Int                   @default(0)
  leaseOwner          String?               @db.VarChar(191)
  leaseExpiresAt      DateTime?             @db.Timestamptz(3)
  sandboxId           String?               @db.VarChar(191)
  sandboxPath         String?               @db.Text
  sandboxExpiresAt    DateTime?             @db.Timestamptz(3)
  mimeType            String?               @db.VarChar(255)
  sizeBytes           BigInt?
  sha256              String?               @db.Char(64)
  durationSeconds     Int?
  width               Int?
  height              Int?
  audio               Boolean?
  priceVersion        String?               @db.VarChar(64)
  estimatedCostCny    Decimal?              @db.Decimal(18, 8)
  costEstimated       Boolean               @default(true)
  errorCode           String?               @db.VarChar(64)
  errorMessage        String?               @db.Text
  cancelledAt         DateTime?             @db.Timestamptz(3)
  timedOutAt          DateTime?             @db.Timestamptz(3)
  startedAt           DateTime?             @db.Timestamptz(3)
  completedAt         DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  requestLog          RequestLog            @relation(fields: [requestLogId], references: [id], onDelete: Cascade)
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  thread              AgentThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agentRun            AgentRun?             @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  agentToolCall       AgentToolCall?        @relation(fields: [agentToolCallId], references: [id], onDelete: SetNull)
  parentVideoTask     VideoGenerationTask?  @relation("VideoTaskChain", fields: [parentVideoTaskId], references: [id], onDelete: SetNull)
  childVideoTasks     VideoGenerationTask[] @relation("VideoTaskChain")
  creation            Creation?

  @@unique([provider, providerTaskId])
  @@index([status, nextPollAt, leaseExpiresAt])
  @@index([userId, createdAt])
  @@index([threadId, createdAt])
  @@index([agentRunId])
}

model VideoInputAsset {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  threadId    String      @db.Uuid
  sandboxId   String?     @db.VarChar(191)
  sandboxPath String?     @db.Text
  objectKey   String?     @db.Text
  name        String      @db.VarChar(255)
  mimeType    String      @db.VarChar(64)
  sizeBytes   BigInt
  sha256      String      @db.Char(64)
  expiresAt   DateTime    @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread      AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, threadId, createdAt])
  @@index([expiresAt])
  @@index([objectKey])
}

model Creation {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @db.Uuid
  type             CreationType
  status           CreationStatus       @default(PENDING)
  title            String               @db.VarChar(200)
  expiresAt        DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  webProject       WebProject?
  imageTaskId      String?              @unique @db.Uuid
  imageTask        ImageGenerationTask? @relation(fields: [imageTaskId], references: [id], onDelete: SetNull)
  videoTaskId      String?              @unique @db.Uuid
  videoTask        VideoGenerationTask? @relation(fields: [videoTaskId], references: [id], onDelete: SetNull)
  parentCreationId String?              @db.Uuid
  parentCreation   Creation?            @relation("CreationVersions", fields: [parentCreationId], references: [id], onDelete: SetNull)
  childCreations   Creation[]           @relation("CreationVersions")
  assets           CreationAsset[]

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([expiresAt])
}

model WebProject {
  id            String           @id @default(uuid()) @db.Uuid
  creationId    String           @unique @db.Uuid
  userId        String           @db.Uuid
  agentThreadId String?          @db.Uuid
  agentRunId    String?          @db.Uuid
  status        WebProjectStatus @default(PENDING)
  framework     String?          @db.VarChar(64)
  buildCommand  String?          @db.VarChar(512)
  outputDir     String?          @db.VarChar(256)
  errorCode     String?          @db.VarChar(64)
  errorMessage  String?          @db.Text
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  creation      Creation         @relation(fields: [creationId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  agentThread   AgentThread?     @relation(fields: [agentThreadId], references: [id], onDelete: SetNull)
  agentRun      AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([userId, agentThreadId])
  @@index([userId, createdAt])
  @@index([agentThreadId])
  @@index([agentRunId])
}

model CreationAsset {
  id         String            @id @default(uuid()) @db.Uuid
  creationId String            @db.Uuid
  kind       CreationAssetKind
  name       String            @db.VarChar(255)
  mimeType   String            @db.VarChar(255)
  objectKey  String            @unique @db.VarChar(1024)
  sizeBytes  BigInt
  sha256     String?           @db.Char(64)
  expiresAt  DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  creation   Creation          @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([creationId, kind])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String           @id @default(uuid()) @db.Uuid
  actor       String           @db.VarChar(64)
  action      AdminAuditAction
  targetTable String           @db.VarChar(64)
  targetId    String           @db.VarChar(191)
  beforeData  Json?
  afterData   Json?
  requestId   String?          @db.Uuid
  sourceIp    String?          @db.VarChar(64)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetTable, createdAt])
}

model AgentThread {
  id                 String                @id @default(uuid()) @db.Uuid
  userId             String                @db.Uuid
  title              String                @db.VarChar(200)
  modelId            String                @db.VarChar(128)
  provider           String                @db.VarChar(64)
  sandboxId          String?               @unique @db.VarChar(191)
  sandboxStatus      String?               @db.VarChar(32)
  sandboxCreatedAt   DateTime?             @db.Timestamptz(3)
  sandboxLastUsedAt  DateTime?             @db.Timestamptz(3)
  sandboxExpiresAt   DateTime?             @db.Timestamptz(3)
  sandboxDestroyedAt DateTime?             @db.Timestamptz(3)
  preferredMode      String?               @db.VarChar(32)
  videoModelBinding  String?               @db.VarChar(128)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages           AgentMessage[]
  runs               AgentRun[]
  contextSummary     AgentContextSummary?
  webProjects        WebProject[]
  videoTasks         VideoGenerationTask[]
  videoInputAssets   VideoInputAsset[]

  @@index([userId, updatedAt])
  @@index([userId, createdAt])
  @@index([sandboxExpiresAt])
}

model AgentContextSummary {
  id                     String      @id @default(uuid()) @db.Uuid
  threadId               String      @unique @db.Uuid
  revision               Int         @default(1)
  coveredThroughSequence Int
  schemaVersion          String      @db.VarChar(32)
  promptHash             String      @db.VarChar(64)
  modelId                String      @db.VarChar(128)
  content                Json
  inputTokens            Int?
  outputTokens           Int?
  totalTokens            Int?
  createdAt              DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime    @updatedAt @db.Timestamptz(3)
  thread                 AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model AgentMessage {
  id        String           @id @default(uuid()) @db.Uuid
  threadId  String           @db.Uuid
  runId     String?          @db.Uuid
  role      AgentMessageRole
  sequence  Int
  parts     Json
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  thread    AgentThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  run       AgentRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([threadId, sequence])
  @@index([threadId, createdAt])
  @@index([runId])
}

model AgentRun {
  id                   String                 @id @default(uuid()) @db.Uuid
  threadId             String                 @db.Uuid
  userId               String                 @db.Uuid
  modelId              String                 @db.VarChar(128)
  provider             String                 @db.VarChar(64)
  mode                 String?                @db.VarChar(32)
  status               AgentRunStatus         @default(RUNNING)
  limitReason          AgentRunLimitReason?
  input                String                 @db.Text
  errorCode            String?                @db.VarChar(64)
  errorMessage         String?                @db.Text
  promptProfileVersion String?                @db.VarChar(64)
  promptHash           String?                @db.VarChar(64)
  promptManifest       Json?
  modelCallCount       Int                    @default(0)
  toolCallCount        Int                    @default(0)
  webFetchCount        Int                    @default(0)
  shellCallCount       Int                    @default(0)
  sandboxId            String?                @db.VarChar(191)
  activeSkillManifest  Json?
  fileManifest         Json?
  sandboxUsage         Json?
  sandboxStartedAt     DateTime?              @db.Timestamptz(3)
  sandboxDestroyedAt   DateTime?              @db.Timestamptz(3)
  inputTokens          Int                    @default(0)
  outputTokens         Int                    @default(0)
  totalTokens          Int                    @default(0)
  usageUnknown         Boolean                @default(false)
  estimatedCostCny     Decimal?               @db.Decimal(18, 8)
  lastSequence         Int                    @default(-1)
  startedAt            DateTime?              @db.Timestamptz(3)
  completedAt          DateTime?              @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  thread               AgentThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  events               AgentEvent[]
  toolCallRecords      AgentToolCall[]
  messages             AgentMessage[]
  requestLogs          RequestLog[]
  files                UserFile[]
  modelInvocations     AgentModelInvocation[]
  userQuestions        AgentUserQuestion[]
  webProjects          WebProject[]
  imageTasks           ImageGenerationTask[]
  videoTasks           VideoGenerationTask[]

  @@index([threadId, createdAt])
  @@index([userId, status])
  @@index([modelId, createdAt])
  @@index([sandboxId])
}

model AgentUserQuestion {
  id         String                    @id @default(uuid()) @db.Uuid
  runId      String                    @db.Uuid
  toolCallId String                    @db.VarChar(191)
  status     AgentUserQuestionStatus   @default(PENDING)
  questions  Json
  createdAt  DateTime                  @default(now()) @db.Timestamptz(3)
  settledAt  DateTime?                 @db.Timestamptz(3)
  run        AgentRun                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  answers    AgentUserQuestionAnswer[]

  @@unique([runId, toolCallId])
  @@index([runId, status])
}

model AgentUserQuestionAnswer {
  id             String            @id @default(uuid()) @db.Uuid
  userQuestionId String            @db.Uuid
  questionItemId String            @db.VarChar(191)
  optionIds      Json
  customText     String?           @db.Text
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  userQuestion   AgentUserQuestion @relation(fields: [userQuestionId], references: [id], onDelete: Cascade)

  @@unique([userQuestionId, questionItemId])
  @@index([userQuestionId])
}

model AgentModelInvocation {
  id                      String                            @id @default(uuid()) @db.Uuid
  requestId               String                            @unique @db.Uuid
  requestLogId            String                            @unique @db.Uuid
  agentRunId              String?                           @db.Uuid
  userId                  String                            @db.Uuid
  status                  AgentInvocationStatus
  provider                String?                           @db.VarChar(64)
  resolvedModel           String?                           @db.VarChar(128)
  inputTokens             Int?
  outputTokens            Int?
  totalTokens             Int?
  cachedInputTokens       Int?
  reasoningTokens         Int?
  usageUnknown            Boolean                           @default(true)
  cacheUsageAvailable     Boolean                           @default(false)
  reasoningUsageAvailable Boolean                           @default(false)
  startedAt               DateTime                          @db.Timestamptz(3)
  completedAt             DateTime                          @db.Timestamptz(3)
  createdAt               DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                          @updatedAt @db.Timestamptz(3)
  requestLog              RequestLog                        @relation(fields: [requestLogId], references: [id], onDelete: Cascade)
  agentRun                AgentRun?                         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  user                    User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  attributions            AgentModelInvocationAttribution[]

  @@index([userId, completedAt])
  @@index([resolvedModel, completedAt])
  @@index([completedAt])
}

model AgentModelInvocationAttribution {
  id           String                         @id @default(uuid()) @db.Uuid
  invocationId String                         @db.Uuid
  kind         AgentInvocationAttributionKind
  name         String                         @db.VarChar(191)
  weight       Decimal                        @default(1) @db.Decimal(10, 8)
  createdAt    DateTime                       @default(now()) @db.Timestamptz(3)
  invocation   AgentModelInvocation           @relation(fields: [invocationId], references: [id], onDelete: Cascade)

  @@unique([invocationId, kind, name])
  @@index([kind, name])
}

model AgentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  sequence  Int
  type      String   @db.VarChar(64)
  payload   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, sequence])
}

model AgentToolCall {
  id                   String               @id @default(uuid()) @db.Uuid
  runId                String               @db.Uuid
  toolCallId           String               @db.VarChar(191)
  toolName             String               @db.VarChar(64)
  args                 Json
  status               AgentToolCallStatus  @default(RUNNING)
  summary              String?              @db.Text
  audit                Json?
  errorCode            String?              @db.VarChar(64)
  errorMessage         String?              @db.Text
  sandboxId            String?              @db.VarChar(191)
  skillId              String?              @db.Uuid
  skillName            String?              @db.VarChar(64)
  packageSha256        String?              @db.Char(64)
  command              String?              @db.Text
  workingDirectory     String?              @db.Text
  exitCode             Int?
  durationMs           Int?
  stdoutBytes          Int?
  stderrBytes          Int?
  stdoutTruncated      Boolean?
  stderrTruncated      Boolean?
  sandboxLimitReason   String?              @db.VarChar(64)
  startedAt            DateTime             @default(now()) @db.Timestamptz(3)
  completedAt          DateTime?            @db.Timestamptz(3)
  result               Json?
  resumeLeaseOwner     String?              @db.VarChar(191)
  resumeLeaseExpiresAt DateTime?            @db.Timestamptz(3)
  run                  AgentRun             @relation(fields: [runId], references: [id], onDelete: Cascade)
  skill                Skill?               @relation(fields: [skillId], references: [id], onDelete: SetNull)
  files                UserFile[]
  imageTask            ImageGenerationTask?
  videoGenerationTask  VideoGenerationTask?

  @@unique([runId, toolCallId])
  @@index([runId])
  @@index([skillId])
  @@index([sandboxId])
}
